# Sentinel — environment template. Copy to .env and fill in.
#   cp .env.example .env
# .env is gitignored and must never be committed.

# --- Speech ---------------------------------------------------------------
# Deepgram Nova (STT) — https://console.deepgram.com
DEEPGRAM_API_KEY=
# Cartesia (TTS) — https://play.cartesia.ai
CARTESIA_API_KEY=

# --- Reasoning ------------------------------------------------------------
# Cerebras (gpt-oss-120b turn loop) — https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# Anthropic (Claude Sonnet 5 escalation judge) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- Data -----------------------------------------------------------------
# Neon Postgres. DATABASE_URL is pooled (services); DATABASE_URL_UNPOOLED is
# direct (migrations). Both from https://console.neon.tech → Connect.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Neon branch this checkout is bound to. Mirrors .neon; `production` by default.
NEON_BRANCH=production

# --- Event bus ------------------------------------------------------------
# Redis 7 from docker-compose.yml. Streams, pub/sub, and keys all live here.
REDIS_URL=redis://localhost:6379/0

# --- Service ports (local) ------------------------------------------------
CORE_API_PORT=8000
RISK_ENGINE_PORT=8001
CALL_ORCHESTRATOR_PORT=8002
AGENT_PORT=8003

# --- Telephony (v1.1 — parked, trial account provisioned) -----------------
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
